{
  "name": "@xinlong/dsh-github-reviewer",
  "description": "DeepSeek Harness plugin: automated GitHub PR review bot ported from LingoBridge",
  "version": "0.1.0-rc1",
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib/**/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "oxlint src tests",
    "publint": "publint"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dependencies": {
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-session-persistence": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@deepseek-ai/dsh-agent-default-model": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-storage-domain": "^0.1.0-rc.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent-loop": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-typert-registry": "^0.1.0-rc.7",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.2.7",
    "oxlint": "^1.79.0",
    "publint": "^0.3.23",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
