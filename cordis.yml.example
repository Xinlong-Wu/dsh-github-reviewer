# DeepSeek Harness cordis.yml example for dsh-github-reviewer.
# 本文件为可编辑脚手架（editable scaffold）：llm / agent-spine / persistence 三段被注释，
# 需替换为你部署实际使用的插件；storage 与 github-reviewer 段可直接用。
# The plugin drives reviews through the harness agent loop, so the deployment
# must mount the agent-loop family; swap in whatever spine/LLM/persistence
# plugins your deployment already uses.
#
# 在真实 profile 中，这些行要放进 profile 的 cordis.patch.yml（或 --patch 覆盖层），
# 且必须包在 `- insert:` 里——patch 顶层的普通行是「按 id 覆盖已有行」的语义，
# 新插件 id 不存在时会报 `patch: entry "<id>" not found`。
# In a real profile these rows go into the profile's cordis.patch.yml (or a
# --patch overlay) WRAPPED IN `- insert:`; a plain top-level row is an
# id-targeted override, and a new plugin id fails with
# `patch: entry "<id>" not found`.
#
# Mount the plugin ONCE PER ACCOUNT (flat config, multi-instance pattern):
# every entry below with `name: '@xinlongwu/dsh-github-reviewer'` runs one
# independent poll loop.

# LLM adapter — replace with whatever LLM plugin your deployment uses.
# - id: llm-deepseek
#   name: '@deepseek-ai/dsh-llm-deepseek'
#   config: { thinking: enabled, models: [{ id: deepseek-chat, contextWindow: 128000 }] }
# The agent loop + system-prompt assembly + tool pipeline. The deployment's
# default model selection (agentDefaultModel) drives every review agent; the
# plugin does not configure a model.
# - id: agent-spine
#   name: '@deepseek-ai/dsh-agent-spine-demo'
#   config:
#     agents: [{ id: main, provider: deepseek-official, model: deepseek-chat, cwd: !!js process.cwd() }]
# Durable sessions: without this, PR sessions are memory-only across restarts.
# - id: session-persistence-jsonl
#   name: '@deepseek-ai/dsh-session-persistence-jsonl'
#   config: { root: './.sessions' }
# The review cursor lives in a storage-domain record per account. The storage
# hub (@deepseek-ai/dsh-storage) must be mounted: both the JSON backend and the
# storage-domain plugin depend on it. Pick the backend: JSON files
# (dsh-storage-json) or a real SQLite database (dsh-storage-sqlite); route it
# in the storage-domain config below.
- id: storage
  name: '@deepseek-ai/dsh-storage'
- id: storage-json
  name: '@deepseek-ai/dsh-storage-json'
  config:
    root: './.storage'
- id: storage-domain
  name: '@deepseek-ai/dsh-storage-domain'
  config:
    backend: json
# Default model selection for every review agent. The plugin does not configure
# a model; it reads agentDefaultModel from this service. Required: without it,
# the cordis fiber stays PENDING and the plugin silently never activates.
- id: agent-default-model
  name: '@deepseek-ai/dsh-agent-default-model'
  config:
    provider: deepseek-official
    model: deepseek-chat

- id: github-reviewer-org
  name: '@xinlongwu/dsh-github-reviewer'
  config:
    # Account label used in logs and the cursor record key in the storage domain.
    name: org
    # Required GitHub App identity. The App needs:
    #   - Pull requests: read/write (reviews and comments)
    #   - Contents: read (on the base repository, for
    #     .github/review_instructions.md and file inspection)
    appId: '123456'
    installationId: '987654'
    privateKeyPath: '/etc/dsh/github-app.pem'
    # Alternative: authenticate as yourself with a personal access token
    # (classic ghp_ or fine-grained github_pat_). Mutually exclusive with
    # the three App fields above — leave them empty when using this.
    # personalAccessToken: 'github_pat_...'
    # Optional. Defaults shown below.
    baseUrl: 'https://api.github.com'
    webUrl: 'https://github.com'
    pollIntervalMs: 120000
    repositories:
      - 'owner/repo'
    # Review sessions are filed under an auto-registered harness workspace
    # (needs the `workspace` service; the web profile bundles it). Default
    # directory: $DSH_HOME/github-reviewer/<name>, title: GithubReviewer.
    # workspaceDir: '/var/lib/dsh/ghr'
    # workspaceTitle: 'GithubReviewer'
    review:
      maxToolCalls: 30
      toolTimeoutMs: 30000
      toolResultLimit: 60000
      # Overall deadline for one review/chat turn; the agent is
      # cancelled past it.
      timeoutMs: 900000
      # Optional fallback used only when the base repository has no
      # .github/review_instructions.md at the PR base.
      defaultInstructions: |
        Review this pull request for correctness, regressions, security issues,
        and missing tests. Leave concise inline comments where useful.
      # Optional review-model candidates, in preference order, resolved at the
      # first session creation (not at mount). The first candidate whose
      # provider is registered and whose model exists in that provider's
      # catalog wins; if none is available that review is aborted and the
      # failure is recorded in the cursor (backoff retry). Omit to use the
      # deployment's default model selection (agentDefaultModel).
      # models:
      #   - { provider: deepseek-official, model: deepseek-v4-flash }
      #   - { provider: ssct-openai, model: gpt-5.2 }
      # Optional. GitHub author_association values allowed to trigger /review
      # and /bot comments. ['*'] allows everyone; [] allows no one.
      commandAuthorAssociations: ['OWNER', 'MEMBER', 'COLLABORATOR']
    # Required per-turn GitHub MCP server. The plugin injects
    # GITHUB_PERSONAL_ACCESS_TOKEN and GITHUB_HOST at runtime; do not
    # put GitHub tokens here.
    mcp:
      command: 'github-mcp-server'
      args:
        - 'stdio'
        - '--tools=pull_request_read,get_file_contents,pull_request_review_write,add_comment_to_pending_review'
      env: {}
      cwd: ''

# A second account is just another plugin instance with its own config.
- id: github-reviewer-personal
  name: '@xinlongwu/dsh-github-reviewer'
  config:
    name: personal
    appId: '654321'
    installationId: '123456'
    privateKeyPath: '/etc/dsh/github-app-2.pem'
    repositories:
      - 'another/repo'
    mcp:
      command: 'github-mcp-server'
      args:
        - 'stdio'
        - '--tools=pull_request_read,get_file_contents,pull_request_review_write,add_comment_to_pending_review'
